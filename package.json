{
  "name": "@ryopc/koshi",
  "version": "6.0.0",
  "description": "Terminal-native decentralized SNS with AI Agent Platform — serverless P2P mesh + MCP + Agent Platform",
  "homepage": "https://koshi.js.org",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "kb": "bin/cli.js",
    "kb-mcp": "bin/kb-mcp.js"
  },
  "scripts": {
    "build": "node build.js",
    "dev:cli": "nodemon --exec node bin/cli.js",
    "start": "node bin/cli.js serve",
    "server": "node src/local/server-standalone.js",
    "server:dev": "nodemon --exec node src/local/server-standalone.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest || true",
    "lint": "eslint . --ext .js || true",
    "check:spec": "node scripts/check-spec-parity.mjs",
    "check:schema": "node scripts/check-schema-valid.mjs",
    "check:agent-card": "node scripts/check-agent-card.mjs",
    "check:backcompat": "node scripts/check-backcompat.mjs",
    "test:mcp": "node scripts/test-mcp.mjs",
    "postinstall": "echo '🍄 Thank you for installing koshi! Type kb --help to get started.'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/ed25519": "^2.0.0",
    "b4a": "^1.8.1",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.3.0",
    "corestore": "^7.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ed2curve": "^0.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.1",
    "helmet": "^7.0.0",
    "hypercore": "^10.38.2",
    "hyperswarm": "^4.17.0",
    "jsonwebtoken": "^9.0.2",
    "nostr-tools": "^2.23.12",
    "ora": "^7.0.1",
    "pg": "^8.11.3",
    "pino": "^8.14.1",
    "tweetnacl": "^1.0.3",
    "uuid": "^14.0.0",
    "ws": "^8.14.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "nodemon": "^3.0.1",
    "pino-pretty": "^10.2.0"
  },
  "license": "MIT",
  "author": "ryopc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryopc/koshi.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./api": "./src/api/index.js",
    "./ws": "./src/ws/index.js",
    "./auth": "./src/auth/jwt.js",
    "./crypto": "./src/auth/ed25519.js",
    "./db": "./src/db/pool.js",
    "./config": "./src/config/config.js",
    "./types": "./src/types/index.ts",
    "./mcp": "./src/mcp/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/auth/",
    "src/config/",
    "src/local/",
    "src/locales/",
    "src/mcp/",
    "src/nostr/",
    "src/p2p/",
    "src/types/",
    "src/i18n.js",
    "src/logger.js",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "sns",
    "decentralized",
    "terminal",
    "cli",
    "ed25519",
    "nostr",
    "agent",
    "mcp",
    "ai",
    "p2p"
  ],
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
